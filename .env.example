# --- chat (RAG, ideas, gaps) ------------------------------------------------
# Preferred: Claude via OpenRouter. Set both:
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- embeddings (semantic / hybrid search) ----------------------------------
# Direct OpenAI key, used ONLY for embeddings by project policy.
OPENAI_API_KEY=

# --- optional fallback (direct Anthropic) -----------------------------------
ANTHROPIC_API_KEY=

# --- routing overrides ------------------------------------------------------
# YTI_PROVIDER: force a chat provider — openrouter | anthropic | openai
YTI_PROVIDER=openrouter

# When YTI_PROVIDER=openrouter, OpenRouter model id (e.g. anthropic/claude-sonnet-4.5).
# Falls back to YTI_OPENROUTER_MODEL, then to anthropic/claude-sonnet-4.5.
YTI_CHAT_MODEL=anthropic/claude-sonnet-4.5

# OpenAI embedding model
YTI_EMBED_MODEL=text-embedding-3-small

# Direct Anthropic chat model (only used if YTI_PROVIDER=anthropic)
YTI_ANTHROPIC_MODEL=claude-sonnet-4-6
